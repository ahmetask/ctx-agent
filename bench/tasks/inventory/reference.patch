     s.add_argument("sku")
     s.set_defaults(func=cmd_show)
 
+    sr = sub.add_parser("set-reorder", help="set an item's reorder level")
+    sr.add_argument("sku")
+    sr.add_argument("level")
+    sr.set_defaults(func=cmd_set_reorder)
+
+    sub.add_parser("alerts", help="items at or below reorder level").set_defaults(func=cmd_alerts)
+
+    rs = sub.add_parser("restock", help="restock alerted items to 2x reorder level")
+    rs.add_argument("--dry-run", action="store_true")
+    rs.set_defaults(func=cmd_restock)
+
     sub.add_parser("value", help="total stock value").set_defaults(func=cmd_value)
 
     i = sub.add_parser("import", help="add items from a CSV (sku,name,qty,price)")
