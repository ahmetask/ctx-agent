diff --git a/inventory/cli.py b/inventory/cli.py
index 24b12ad..7e28790 100644
--- a/inventory/cli.py
+++ b/inventory/cli.py
@@ -51,10 +51,49 @@ def cmd_show(store, args):
     print(f"sku: {item.sku}")
     print(f"name: {item.name}")
     print(f"qty: {item.qty}")
+    print(f"reorder_level: {item.reorder_level}")
     print(f"unit_price: {format_cents(item.unit_price_cents)}")
     print(f"value: {format_cents(item.value_cents)}")
 
 
+def cmd_set_reorder(store, args):
+    item = store.get(args.sku)
+    level = _int(args.level)
+    if level < 0:
+        raise InvalidValue(f"reorder level must not be negative: {level}")
+    item.reorder_level = level
+    store.save()
+    print(f"{args.sku} reorder_level {level}")
+
+
+def _alerted(store):
+    items = [i for i in store.items.values() if i.reorder_level > 0 and i.qty <= i.reorder_level]
+    return sorted(items, key=lambda i: (-(i.reorder_level - i.qty), i.sku))
+
+
+def cmd_alerts(store, args):
+    rows = [(i.sku, i.name, i.qty, i.reorder_level, i.reorder_level - i.qty) for i in _alerted(store)]
+    if not rows:
+        print("no alerts")
+        return
+    print(table.render(["SKU", "NAME", "QTY", "REORDER", "SHORT"], rows,
+                       numeric={"QTY", "REORDER", "SHORT"}))
+
+
+def cmd_restock(store, args):
+    items = _alerted(store)
+    units = cost = 0
+    for i in items:
+        added = 2 * i.reorder_level - i.qty
+        units += added
+        cost += added * i.unit_price_cents
+        i.qty += added
+    verb = "would restock" if args.dry_run else "restocked"
+    if not args.dry_run:
+        store.save()
+    print(f"{verb} {len(items)} item(s), {units} unit(s), cost {format_cents(cost)}")
+
+
 def cmd_value(store, args):
     total = sum(i.value_cents for i in store.items.values())
     print(f"total value: {format_cents(total)} across {len(store.items)} item(s)")
